# Author recorded in patches/<dep>/*.patch. Keep personal addresses out of
# the repository; the GitHub noreply address preserves attribution.
PATCH_AUTHOR="clsx524 <clsx524@users.noreply.github.com>"

# Dependency pins for caihong-omarchy.
#
# COMMIT is the upstream commit recorded by the submodule gitlink.
# TREE is the tree hash after applying patches/<dep>/series in order.
# For a dependency without a series, TREE equals the commit's tree.
#
# prepare-sources.sh and verify-patches.sh compare the applied tree against
# TREE, so a patch that applies with fuzz but changes semantics fails loudly.

