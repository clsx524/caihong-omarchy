 scripts/verify-armada-rootfs.sh                 | 5 +++--
 14 files changed, 33 insertions(+), 19 deletions(-)

diff --git a/scripts/build-archlinuxarm-rootfs.sh b/scripts/build-archlinuxarm-rootfs.sh
index 960747b..b23e546 100755
--- a/scripts/build-archlinuxarm-rootfs.sh
+++ b/scripts/build-archlinuxarm-rootfs.sh
@@ -5,6 +5,7 @@ set -eu
