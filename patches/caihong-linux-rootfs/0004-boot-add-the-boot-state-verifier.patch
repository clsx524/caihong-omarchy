+
+    def test_conflicting_saved_and_cmdline_slots_refused(self):
+        self.slotfile.write_text('a\n')
+        with self.assertRaisesRegex(BOOT.Refusal, 'contradictory'):
+            BOOT.verify()
+
+    def test_conflicting_command_line_slots_refused(self):
