 packaging/linux-caihong/install-current-slot | 134 ++------
 scripts/build-linux-caihong-package.sh       |   9 +-
 scripts/build-linux-caihong-rpm.sh           |  11 +-
 scripts/verify-archlinuxarm-rootfs.sh        |  23 +-
 tools/test-caihong-boot-provider.py          | 339 +++++++++++++++++++
 6 files changed, 611 insertions(+), 115 deletions(-)
 create mode 100755 packaging/linux-caihong/boot-state
 create mode 100755 tools/test-caihong-boot-provider.py

diff --git a/packaging/linux-caihong/boot-state b/packaging/linux-caihong/boot-state
new file mode 100755
index 0000000..8a67559
--- /dev/null
+++ b/packaging/linux-caihong/boot-state
@@ -0,0 +1,210 @@
+#!/usr/bin/python3 -I
+# SPDX-License-Identifier: GPL-2.0-only
+"""Read-only live direct-root identity used by linux-caihong's sole flasher."""
+import os
+from pathlib import Path
+import re
+import stat
+import struct
+import subprocess
+import sys
+
+PACKAGE = Path('/usr/lib/linux-caihong')
+PARTITIONS = Path('/dev/disk/by-partlabel')
+COMPATIBLE = Path('/sys/firmware/devicetree/base/compatible')
+CMDLINE = Path('/proc/cmdline')
+SLOT_FILE = Path('/run/caihong/boot-slot')
+OFFLINE = Path('/run/caihong/offline-rootfs-build')
+SYS_BLOCK = Path('/sys/class/block')
+MODULES = Path('/usr/lib/modules')
+
+
+class Refusal(RuntimeError):
+    pass
+
+
+def require(condition, message):
+    if not condition:
+        raise Refusal(message)
+
+
+def command(*args):
+    # Arch merges sbin into bin; the RPM payload also serves distributions
+    # which still install util-linux's administrative tools in /usr/sbin.
+    tool = Path(args[0])
+    if not tool.is_file():
+        tool = Path('/usr/sbin') / tool.name
+    return subprocess.run((str(tool), *args[1:]), check=True, capture_output=True, text=True,
+                          env={'PATH': '/usr/bin:/usr/sbin', 'LC_ALL': 'C'}).stdout.strip()
+
+
+def live_platform():
+    require(not OFFLINE.exists(), 'offline rootfs construction cannot verify live boot state')
+    require(Path('/proc/1/root').samefile('/'), 'refusing boot verification inside a chroot')
+    tokens = COMPATIBLE.read_bytes().split(b'\0')
+    require(b'oneplus,caihong' in tokens and b'qcom,sm8650' in tokens,
+            'requires live oneplus,caihong / qcom,sm8650 device tree')
+    require(os.uname().machine == 'aarch64', 'requires aarch64 hardware')
+
+
+def block_device(path):
+    resolved = path.resolve(strict=True)
+    require(stat.S_ISBLK(resolved.stat().st_mode), f'not a block device: {path}')
+    return resolved
+
+
+def packaged_release():
+    release = (PACKAGE / 'kernel-release').read_text().strip()
+    require(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9.+_-]*', release), 'invalid packaged kernel release')
+    return release
+
+
+def running_slot():
+    hints = []
+    if SLOT_FILE.exists():
+        saved = SLOT_FILE.read_text().strip()
+        require(saved in ('a', 'b'), 'invalid saved boot slot')
+        hints.append(saved)
+    for token in CMDLINE.read_text().split():
+        if token.startswith(('androidboot.slot_suffix=', 'slot_suffix=')):
+            suffix = token.split('=', 1)[1]
+            require(suffix in ('_a', '_b'), 'invalid command-line boot slot')
+            hints.append(suffix[1:])
+    require(len(set(hints)) <= 1, 'contradictory running boot slot identities')
+    # Partition contents identify an installed image, not the running slot:
+    # updates replace kernels and bytes beyond the new image may remain.
+    require(hints, 'missing running boot slot identity; refusing to guess from partition contents')
+    return hints[0]
+
+
+def root_identity():
+    require(command('/usr/bin/findmnt', '-nro', 'FSTYPE', '/') == 'ext4',
+            'only an unencrypted direct ext4 root is supported')
+    source = block_device(Path(command('/usr/bin/findmnt', '-nro', 'SOURCE', '/')))
+    mounted = command('/usr/bin/findmnt', '-nro', 'MAJ:MIN', '/')
+    device = source.stat().st_rdev
+    require(mounted == f'{os.major(device)}:{os.minor(device)}', 'root device identity mismatch')
+    label = command('/usr/bin/blkid', '-s', 'PARTLABEL', '-o', 'value', str(source))
+    require(label in ('linux', 'userdata'), 'root is not PARTLABEL=linux or PARTLABEL=userdata')
+    require(block_device(PARTITIONS / label) == source, 'root PARTLABEL resolves to another device')
+    roots = [token for token in CMDLINE.read_text().split() if token.startswith('root=')]
+    require(roots == [f'root=PARTLABEL={label}'], 'running command line does not name the direct root')
+    return label
+
+
+def resolve():
+    live_platform()
+    label = root_identity()
+    release = packaged_release()
+    slot = running_slot()
+    image = PACKAGE / f'boot-{label}.img'
+    require(image.is_file() and not image.is_symlink(), f'missing regular boot payload: {image}')
+    target = block_device(PARTITIONS / f'boot_{slot}')
+    return slot, label, image, target, release
+
+
+def next_boot_slot():
+    # qbootctl -a defaults to A on errors and accepts multiple active slots.
+    # Query the same GPT attributes read-only instead. qbootctl gpt-utils.h
+    # defines ACTIVE at bit 50, UNBOOTABLE at bit 55 (AB_FLAG_OFFSET + 6).
+    active = []
+    for slot in ('a', 'b'):
+        target = block_device(PARTITIONS / f'boot_{slot}')
+        sysfs = (SYS_BLOCK / target.name).resolve(strict=True)
+        number = (sysfs / 'partition').read_text().strip()
+        require(number.isdecimal(), 'missing boot partition number')
+        disk = block_device(Path('/dev') / sysfs.parent.name)
+        attrs = command('/usr/bin/sfdisk', '--part-attrs', str(disk), number)
+        guid = re.search(r'(?:^|\s)GUID:([0-9,]+)(?:\s|$)', attrs)
+        bits = {int(bit) for bit in guid.group(1).split(',')} if guid else set()
+        if 50 in bits:
+            require(55 not in bits, f'active boot_{slot} is marked unbootable')
+            active.append(slot)
+    require(len(active) == 1, 'GPT does not select exactly one next-boot slot')
+    return active[0]
+
+
+def verify_image(image, label, release):
+    with image.open('rb') as stream:
+        header = stream.read(1660)
+        require(len(header) == 1660 and header[:8] == b'ANDROID!', 'not an Android boot image v2')
+        kernel_size = struct.unpack_from('<I', header, 8)[0]
+        page = struct.unpack_from('<I', header, 36)[0]
+        require(struct.unpack_from('<I', header, 40)[0] == 2 and
+                struct.unpack_from('<I', header, 1644)[0] >= 1660, 'expected boot header v2')
+        require(page >= 2048 and page & (page - 1) == 0, 'invalid boot page size')
+        require(all(struct.unpack_from('<I', header, offset)[0] == 0 for offset in (16, 24, 1632)),
+                'direct-root image must not contain a ramdisk or auxiliary payload')
+        dtb_size = struct.unpack_from('<I', header, 1648)[0]
+        dtb_start = (page + kernel_size + page - 1) & ~(page - 1)
+        require(kernel_size > 0 and dtb_size > 0 and dtb_start + dtb_size <= image.stat().st_size,
+                'truncated kernel or DTB payload')
+        tokens = (header[64:576] + header[608:1632]).split(b'\0', 1)[0].decode('ascii').split()
+        require([token for token in tokens if token.startswith('root=')] == [f'root=PARTLABEL={label}'],
+                'boot payload root does not match the mounted root')
+        require(all(token in tokens for token in ('rootfstype=ext4', 'rootwait', 'rw')) and
+                not any(token.startswith(('rdinit=', 'init=', 'cryptdevice=', 'rd.luks.')) for token in tokens),
+                'boot payload is not a supported direct-root command line')
+        stream.seek(page)
+        kernel = stream.read(kernel_size)
+        require(b'Linux version ' + release.encode('ascii') + b' ' in kernel,
+                'boot payload kernel does not match packaged module release')
+
+
+def same_bytes(first, second):
+    with first.open('rb') as source, second.open('rb') as target:
+        while chunk := source.read(1024 * 1024):
+            if target.read(len(chunk)) != chunk:
+                return False
+    return True
+
+
+def verify_modules(release):
+    private = PACKAGE / 'modules' / release
+    runtime = MODULES / release
+    require(private.is_dir() and runtime.is_dir() and not runtime.is_symlink(),
+            f'missing installed modules for next-boot kernel {release}')
+    modules = sorted(private.rglob('*.ko*'))
+    require(modules, f'empty module payload for {release}')
+    immutable = modules + [private / name for name in
+                           ('modules.order', 'modules.builtin', 'modules.builtin.modinfo')]
+    for source in immutable:
+        target = runtime / source.relative_to(private)
+        require(source.is_file() and not source.is_symlink() and
+                target.is_file() and not target.is_symlink() and
+                source.stat().st_size == target.stat().st_size and same_bytes(source, target),
+                f'missing or mismatched installed module payload: {target}')
+    for name in ('modules.dep', 'modules.dep.bin', 'modules.alias', 'modules.alias.bin'):
+        target = runtime / name
+        require(target.is_file() and not target.is_symlink() and target.stat().st_size > 0,
+                f'missing module dependency index: {target}')
+
+
+def verify():
+    slot, label, image, target, release = resolve()
+    require(next_boot_slot() == slot, 'next boot selects another slot; select Caihong Linux with caihong-slot first')
+    verify_image(image, label, release)
+    verify_modules(release)
+    size = image.stat().st_size
+    capacity = int(command('/usr/bin/blockdev', '--getsize64', str(target)))
+    require(0 < size <= capacity, 'boot payload exceeds the boot partition')
+    require(same_bytes(image, target), f'boot_{slot} differs from installed next-boot payload {release}')
+    print(f'linux-caihong: verified next-boot {release} slot={slot} root_partlabel={label} target={target}')
+
+
+def main():
+    require(os.geteuid() == 0, 'must run as root')
+    require(len(sys.argv) == 2 and sys.argv[1] in ('--resolve', '--verify'),
+            'usage: boot-state --resolve|--verify')
+    if sys.argv[1] == '--verify':
+        verify()
+    else:
+        slot, label, image, target, _release = resolve()
+        print(slot, label, image, target)
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (Refusal, OSError, ValueError, subprocess.SubprocessError) as error:
+        sys.exit(f'linux-caihong: {error}')
