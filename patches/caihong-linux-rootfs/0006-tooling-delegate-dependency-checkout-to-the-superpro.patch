From 999737c08c8f58b549277766d325a3571538145c Mon Sep 17 00:00:00 2001
From: clsx524 <clsx524@users.noreply.github.com>
Date: Mon, 16 Nov 2026 00:46:37 -0800
Subject: [PATCH 6/7] tooling: delegate dependency checkout to the superproject

The superproject owns the pins and patch series. Replace the standalone checkout logic with an exec of the superproject's prepare-sources.sh.
---
 scripts/checkout-dependencies.sh | 84 +++-----------------------------
 1 file changed, 6 insertions(+), 78 deletions(-)

diff --git a/scripts/checkout-dependencies.sh b/scripts/checkout-dependencies.sh
index 561b5f8..136dc4d 100755
--- a/scripts/checkout-dependencies.sh
+++ b/scripts/checkout-dependencies.sh
@@ -1,85 +1,13 @@
 #!/bin/sh
 # SPDX-License-Identifier: GPL-2.0-only
 # Copyright (c) 2026 Osilvfe <osilvfe@gmail.com>
+#
+# Compatibility entry point for the build scripts. Dependencies are now
+# submodules pinned in pins.env; prepare-sources.sh checks them out and
+# applies the local patch series.
 set -eu
 CDPATH=
 
 project_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
-# shellcheck source=config/dependencies.env
-. "$project_dir/config/dependencies.env"
-dependency_scope=${DEPENDENCY_SCOPE:-release}
-
-case "$dependency_scope" in
-	release|kernel) ;;
-	*)
-		echo "DEPENDENCY_SCOPE must be release or kernel" >&2
-		exit 2
-		;;
-esac
-
-checkout()
-{
-	name=$1
-	ref=$2
-	target=$3
-	repository=$4
-	if [ -d "$target/.git" ]; then
-		if [ -n "$(git -C "$target" status --porcelain --untracked-files=no)" ]; then
-			echo "refusing a dependency with uncommitted changes: $target" >&2
-			exit 1
-		fi
-		git -C "$target" remote set-url origin "$repository"
-	else
-		rm -rf -- "$target"
-		mkdir -p "$(dirname -- "$target")"
-		git init -q "$target"
-		git -C "$target" remote add origin "$repository"
-	fi
-	attempt=1
-	while ! git -C "$target" fetch --depth=1 origin "$ref"; do
-		if [ "$attempt" -ge 4 ]; then
-			echo "failed to fetch $name after $attempt attempts" >&2
-			exit 1
-		fi
-		echo "retrying $name fetch ($attempt/4)" >&2
-		sleep $((attempt * 2))
-		attempt=$((attempt + 1))
-	done
-	git -C "$target" checkout -q --detach FETCH_HEAD
-	actual=$(git -C "$target" rev-parse HEAD)
-	{
-		printf '%s_REPOSITORY=%s\n' "$name" "$repository"
-		printf '%s_REF=%s\n' "$name" "$ref"
-		printf '%s_COMMIT=%s\n' "$name" "$actual"
-	} >> "$resolved"
-}
-
-mkdir -p "$project_dir/build"
-resolved="$project_dir/build/dependencies.resolved.env"
-: > "$resolved"
-checkout LINUX "$LINUX_REF" "$project_dir/linux" "$LINUX_REPOSITORY"
-if [ "$dependency_scope" = release ]; then
-	checkout LIBCAMERA "$LIBCAMERA_REF" \
-		"$project_dir/external/libcamera" "$LIBCAMERA_REPOSITORY"
-	checkout PLASMA_CAMERA "$PLASMA_CAMERA_REF" \
-		"$project_dir/external/plasma-camera" "$PLASMA_CAMERA_REPOSITORY"
-fi
-checkout TOOLBOX "$TOOLBOX_REF" \
-	"$project_dir/external/caihong-toolbox" "$TOOLBOX_REPOSITORY"
-checkout LIBSSC "$LIBSSC_REF" \
-	"$project_dir/external/libssc" "$LIBSSC_REPOSITORY"
-# The incremental platform package also embeds the VA-API driver, and the
-# kernel-only workflow builds that package without the rootfs dependencies.
-checkout QCOM_VA "$QCOM_VA_REF" \
-	"$project_dir/external/qcom-va-driver" "$QCOM_VA_REPOSITORY"
-if [ "$dependency_scope" = release ]; then
-	checkout QBOOTCTL "$QBOOTCTL_REF" \
-		"$project_dir/external/qbootctl" "$QBOOTCTL_REPOSITORY"
-	checkout POWER_PROFILES_DAEMON "$POWER_PROFILES_DAEMON_REF" \
-		"$project_dir/external/power-profiles-daemon" \
-		"$POWER_PROFILES_DAEMON_REPOSITORY"
-fi
-checkout MKBOOTIMG "$MKBOOTIMG_REF" \
-	"$project_dir/external/mkbootimg" "$MKBOOTIMG_REPOSITORY"
-echo "checked out Caihong $dependency_scope dependencies"
-cat "$resolved"
+project_root=${CAIHONG_PROJECT_ROOT:-$(cd -- "$project_dir/.." && pwd)}
+exec "$project_root/scripts/prepare-sources.sh"
-- 
