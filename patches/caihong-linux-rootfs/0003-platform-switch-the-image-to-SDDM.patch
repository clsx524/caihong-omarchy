From e4086a18cf8041144a601721013a16ecfcca2a35 Mon Sep 17 00:00:00 2001
From: clsx524 <clsx524@users.noreply.github.com>
Date: Mon, 16 Nov 2026 00:46:26 -0800
Subject: [PATCH 3/7] platform: switch the image to SDDM

Omarchy ships SDDM, so install and enable it instead of Plasma Login Manager. Drop the PLM conflicts from the platform package, migrate existing PLM installations, and update the payload and migration tests.
---
 .../switch-display-manager.sh                 |  49 ++-
 scripts/package-archlinuxarm-rootfs.sh        |  10 +-
 scripts/package-caihong-platform.py           |   3 +-
 scripts/platform_runtime.py                   |   2 +-
 tools/test-display-manager-migration.py       | 323 ++++++++++--------
 tools/test-platform-payload.py                |   4 -
 tools/test-platform-ssc-package.py            |  15 +-
 7 files changed, 240 insertions(+), 166 deletions(-)

diff --git a/packaging/caihong-platform/switch-display-manager.sh b/packaging/caihong-platform/switch-display-manager.sh
index ea751b3..a031b05 100755
--- a/packaging/caihong-platform/switch-display-manager.sh
+++ b/packaging/caihong-platform/switch-display-manager.sh
@@ -2,10 +2,9 @@
 # SPDX-License-Identifier: GPL-2.0-only
 # Copyright (c) 2026 Osilvfe <osilvfe@gmail.com>
 #
-# Switch an existing Arch Linux ARM installation from SDDM to Plasma Login
-# Manager.  The rootfs image builder installs PLM directly and does not need
-# this script, but update packages must handle devices created before PLM was
-# the default display manager.
+# Select SDDM on existing Arch Linux ARM installations that used Plasma Login
+# Manager.  Image builders enable SDDM directly; this migration only applies
+# to incremental platform package updates and never restarts a live session.
 
 set -eu
 CDPATH=
@@ -21,11 +20,15 @@ if [ "${CAIHONG_PLATFORM_SKIP_DISPLAY_MANAGER:-0}" = 1 ]; then
 	exit 0
 fi
 
-# Only the incremental update installer is allowed to replace SDDM.  Image
-# builders install and enable PLM themselves and must not run this migration.
+# Only the incremental update installer is allowed to change the selection.
+# Offline image builds install and enable SDDM themselves.
 if [ "${CAIHONG_PLATFORM_UPDATE_INSTALL:-0}" != 1 ]; then
 	exit 0
 fi
+if [ "${CAIHONG_PLATFORM_IMAGE_BUILD:-0}" = 1 ] ||
+	[ -e "$root/run/caihong/offline-rootfs-build" ]; then
+	exit 0
+fi
 
 if [ ! -x "$root/usr/bin/pacman" ]; then
 	# The platform package is also used for non-Arch distributions.  Leave
@@ -47,7 +50,7 @@ alias=$root/etc/systemd/system/display-manager.service
 # A display manager can be enabled without updating display-manager.service,
 # for example `systemctl enable ly.service`.  Treat any explicitly enabled
 # third-party manager as an administrator choice even if the alias still points
-# at stock SDDM.
+# at the distribution default.
 for unit in \
 	gdm.service gdm3.service lightdm.service ly.service greetd.service \
 	lemurs.service lxdm.service nodm.service slim.service wdm.service \
@@ -59,29 +62,41 @@ for unit in \
 done
 
 # Never override a display manager that the administrator selected through the
-# display-manager.service alias.  Only the stock SDDM selection, an empty
-# selection, or an existing PLM selection is migrated automatically.
+# display-manager.service alias.  Only the stock PLM selection, an empty
+# selection, or an existing SDDM selection is managed automatically.
 if [ -L "$alias" ]; then
 	target=$(readlink -- "$alias")
 	case $target in
-		*/sddm.service|*/plasmalogin.service) ;;
+		sddm.service|*/sddm.service|plasmalogin.service|*/plasmalogin.service) ;;
 		*)
 			echo "keeping administrator-selected display manager: $target" >&2
 			exit 0
 			;;
 	esac
+elif [ -e "$alias" ]; then
+	echo "keeping administrator-provided display-manager.service" >&2
+	exit 0
 fi
 
-if [ ! -e "$root/usr/lib/systemd/system/plasmalogin.service" ]; then
-	echo "plasmalogin.service is missing; install the plasma-login-manager dependency" >&2
+if [ ! -e "$root/usr/lib/systemd/system/sddm.service" ]; then
+	echo "sddm.service is missing; install the sddm dependency" >&2
 	exit 1
 fi
 
-# SDDM and PLM share the display-manager.service alias.  Remove the stale
-# alias before enabling PLM; systemctl will not replace an existing alias.
+# Disable the old unit as well as replacing its alias: PLM may also have been
+# enabled directly under a target's wants directory.  Do not stop either manager.
+if [ -e "$root/usr/lib/systemd/system/plasmalogin.service" ] ||
+	run_systemctl is-enabled --quiet plasmalogin.service >/dev/null 2>&1; then
+	run_systemctl disable plasmalogin.service >/dev/null
+fi
+
+# SDDM and PLM share the display-manager.service alias.  Keep an existing SDDM
+# alias intact, but remove a stale PLM alias before asking systemctl to enable.
 if [ -L "$alias" ]; then
-	rm -f -- "$alias"
+	case $(readlink -- "$alias") in
+		plasmalogin.service|*/plasmalogin.service) rm -f -- "$alias" ;;
+	esac
 fi
-run_systemctl enable plasmalogin.service >/dev/null
+run_systemctl enable sddm.service >/dev/null
 
-echo "Plasma Login Manager is now the active display manager" >&2
+echo "SDDM is now the selected display manager" >&2
